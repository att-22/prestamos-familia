# Backend environment variables
# Copy to .env and fill in your values

# Database (PostgreSQL)
DATABASE_URL=postgresql://prestamos:prestamos_dev@localhost:5432/prestamos

# Auth
# Secret used to sign JWTs. At least 32 characters in production, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me
# Who may create an account: exact emails or whole domains, comma-separated
ALLOWED_EMAILS=someone@example.com,@example.org
# Code people must enter to register. Required in production.
REGISTRATION_CODE=

# App
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173
