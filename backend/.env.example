# Backend environment variables
# Copy to .env and fill in your values

# Database (PostgreSQL)
DATABASE_URL=postgresql://prestamos:prestamos_dev@localhost:5432/prestamos

# Auth
# Secret used to sign JWTs. At least 32 characters in production, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me
# Optional fixed allow-list, on top of what the administrator adds from the
# app: exact emails or whole domains, comma-separated
ALLOWED_EMAILS=
# Code people must enter to register. Required in production.
REGISTRATION_CODE=
# Account that manages the allowed addresses from the admin page. It can
# always register, and becomes an administrator when it does.
ADMIN_EMAIL=you@example.com

# App
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173
